{
  "manifest_version": 3,
  "name": "GitHub Issues Navigator",
  "version": "1.1.0",
  "description": "Step through the issues and pull requests in a repository's issue or pull request list, with Previous and Next controls and keyboard shortcuts",
  "host_permissions": [
    "https://github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/routes.js",
        "src/list-data.js",
        "src/queue.js",
        "src/context.js",
        "src/keys.js",
        "src/controls.js",
        "src/main.js"
      ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Issues Navigator"
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
}
